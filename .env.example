# ==============================================================================
# Environment Configuration Template for Tender Intelligence Agent
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector)
# (In-memory/local SQLite store is automatically used as zero-config fallback if PostgreSQL is unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tender_db
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/tender_test

# Primary LLM Configuration (Groq / LiteLLM Gateway)
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODEL=groq/qwen/qwen3.6-27b

# Embedding Model Configuration (Jina AI / Open Source)
EMBEDDING_API_KEY=jina_your_api_key_here
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSION=768

# General Application Settings
TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Feature Flags & Automated Discovery Scheduler
INGESTION_ENABLED=true
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=60
OCR_SPACE_API_KEY=
